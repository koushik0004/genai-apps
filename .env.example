# OpenRouter API Credentials
OPENROUTER_API_KEY=

# Base URL for OpenRouter (OpenAI-compatible)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model to use
DEFAULT_MODEL=google/gemini-2.5-flash
GEMINI_GEMMA_MODEL=google/gemma-4-31b-it
QWEN_MODEL=qwen/qwen3.7-flash
QUEN_STRONG_MODEL=qwen/qwen3.8-27B
OPENAI_NANO_MODEL=openai/gpt-4.1-nano
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
OPEN_ROUTER_OSS_MODEL=openai/gpt-oss-120b
ANTHROPIC_HAIKU_MODEL=anthropic/claude-haiku-5.5:batch
MISTRAL_NEMO_MODEL=mistralai/mistral-nemo
DEEPSEEK_V4_FLASH_MODEL=deepseek/deepseek-v4-flash-0731

# Text embedding models
TEXT_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_MODEL=all-MiniLM-L12-v2

# Prompt
# - make sure to analyze the messages from AI, and find the issue
# - make sure to plan correctly how to resolve such issue
# - make sure to identify the code change
# - make sure to list the plan and expected code change briefly
# - make sure not to update any code directly